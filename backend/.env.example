# API
PORT=8787

# Durable storage is required for public production deployment.
# If omitted, backend uses an in-memory store for local dev/CI only.
# DATABASE_URL=postgresql://user:password@localhost:5432/spondee

# Explicit browser origins for a separately hosted frontend.
# Comma-separated; wildcard CORS is intentionally not used.
# SPONDEE_CORS_ORIGINS=https://app.example.com,https://preview.example.com

# Server-only protection for consequential backend mutation surfaces.
# Use independent random values >= 24 chars. Never expose these to browser bundles.
# SPONDEE_ACTION_TOKEN=...
# SPONDEE_EVIDENCE_INGEST_TOKEN=...

# Official 8004scan discovery API. API key is optional because anonymous reads are supported,
# but when configured it remains server-side and must never be sent to the browser.
SPONDEE_8004SCAN_API_BASE_URL=https://api.8004scan.io/api/v1
SPONDEE_8004SCAN_CACHE_SECONDS=60
# SPONDEE_8004SCAN_API_KEY=...

# ---------------------------------------------------------------------------
# Protected LIVE BSC-testnet execution. Keep disabled during normal dev/CI.
# ---------------------------------------------------------------------------
SPONDEE_LIVE_TESTNET_ENABLED=false
SPONDEE_PROVIDER_ADDRESS=0x3CC4d66BD9f872d803c1Ce063c1426fB7aec38A8
# SPONDEE_SELLER_A2A_URL=http://127.0.0.1:8010

# Buyer must be a SEPARATE throwaway BSC-testnet wallet stored locally as an
# encrypted BNB SDK Keystore V3. Never commit keystore or password.
# BUYER_WALLET_ADDRESS=0x...
# BUYER_WALLETS_DIR=C:\path\to\local\buyer-wallets
# BUYER_WALLET_PASSWORD=entered-locally-only

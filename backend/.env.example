# API
PORT=8787

# Optional durable storage. If omitted, backend uses an in-memory store.
# DATABASE_URL=postgresql://user:password@localhost:5432/spondee

# ---------------------------------------------------------------------------
# Protected LIVE BSC-testnet execution. Keep disabled during normal dev/CI.
# ---------------------------------------------------------------------------
SPONDEE_LIVE_TESTNET_ENABLED=false
SPONDEE_PROVIDER_ADDRESS=0x3CC4d66BD9f872d803c1Ce063c1426fB7aec38A8
# SPONDEE_SELLER_A2A_URL=http://127.0.0.1:8010

# Buyer must be a SEPARATE throwaway BSC-testnet wallet stored locally as an
# encrypted BNB SDK Keystore V3. Never commit keystore or password.
# BUYER_WALLET_ADDRESS=0x...
# BUYER_WALLETS_DIR=C:\path\to\local\buyer-wallets
# BUYER_WALLET_PASSWORD=entered-locally-only
